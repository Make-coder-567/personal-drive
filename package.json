{
  "name": "personal-drive",
  "version": "1.0.0",
  "private": true,
  "author": "个人云盘",
  "description": "个人云盘：一套 Web 内核输出到 Web / Android / Windows 三端",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/build-all.mjs --dev",
    "gen:config": "node scripts/gen-config.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "build:web": "node scripts/build-all.mjs --web",
    "build:android": "node scripts/build-all.mjs --android",
    "build:win": "node scripts/build-all.mjs --windows",
    "build:all": "node scripts/build-all.mjs --all",
    "release:android": "node scripts/release-android.mjs",
    "release:windows": "node scripts/release-windows.mjs",
    "gen:store-assets": "node scripts/gen-store-assets.mjs",
    "build:pages": "node scripts/build-github-pages.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@tencent-ai/workbuddy-cloud-sdk": "0.1.4",
    "client-zip": "2.5.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.24.2",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
