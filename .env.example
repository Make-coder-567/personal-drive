# 全部环境变量样例（占位值，无真实密钥）。生产由 CI / 运维注入，禁止把真实值提交仓库。
# 后端 API 地址（必须 HTTPS，前端会作为 SDK endpoint）
VITE_ENDPOINT=https://api.example.com
# OAuth 中继地址
VITE_OAUTH_RELAY_BASE_URL=https://relay.example.com/oauth
# WorkBuddy Cloud publishableKey（生产值由 CI 注入）
VITE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
# 默认站点访问码（分享链接 sharecode 参数）
VITE_DEFAULT_SITE_CODE=REPLACE_WITH_SITE_CODE
# 公开分享落地页基址（不带尾斜杠）
VITE_SHARE_BASE_URL=https://drive.example.com
# Service Worker 地址，保持相对路径以兼容子目录部署与原生 WebView
VITE_SW_URL=./sw.js
# SW 下载拦截前缀（默认 /__dl__/）
VITE_DL_PREFIX=/__dl__/
# 平台：web / electron / android，原生宿主也可运行时覆盖
VITE_PLATFORM=web
# 上传分片大小（MB）与并发数
VITE_CHUNK_MB=8
VITE_UPLOAD_CONC=6
# CSP 白名单（空格分隔的 source 列表）
VITE_CSP_SCRIPT_SRC='self'
VITE_CSP_CONNECT_SRC='self' https://api.example.com
VITE_CSP_IMG_SRC='self' data: blob:
VITE_CSP_STYLE_SRC='self' 'unsafe-inline'
VITE_CSP_FRAME_SRC='self'
