# WorkBuddy 本地会话/记忆数据，含内部调试信息，不应公开
.workbuddy/
*.genie

# 依赖与系统文件
node_modules/
# 本地自举的工具链（JDK/SDK/Gradle 下载物，约数百 MB，不入仓库）
.toolchain/
.DS_Store
Thumbs.db
*.log

# 构建产物
dist/
build/
public/__config__.js
public/vendor/
.vite/

# 环境变量：只提交样例
.env
.env.*
!.env.example

# 签名材料（绝不入库）
*.jks
*.keystore
*.p12
*.pfx
android/keystore/
electron/certs/
release/secrets/

# 发布候选包（由脚本生成）
release/android/*.apk
release/android/*.aab
release/windows/*.exe
release/windows/store/*.msix
release/windows/store/*.msixupload
release/windows/store/*.appx

# Android / Capacitor 本地文件
android/.gradle/
android/local.properties
android/app/build/
android/build/
android/captures/
android/.idea/

# Electron 打包缓存
electron-builder.yml.local
.electron-builder.stage.yml
.electron-builder.release.yml

# 发布构建临时目录
release/github-pages/downloads/

# 站点运行时生成物：dist 副本含生产 publishableKey / 站点码，禁止入库
release/github-pages/app/
release/github-pages/sw.js
release/windows/store/win-unpacked/
release/windows/store/builder-debug.yml
*.gh_assets.json

# GitHub API 临时响应文件
.gh_*.json
.ghpages_index.html
.up_*.json
